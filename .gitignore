/.phpunit.cache
.phpunit.result.cache
/node_modules
.editorconfig
features/
/public/build
/public/hot
/public/storage
# Package assets — published by `vendor:publish --tag=laravel-assets`, which the
# Docker build runs. Committing them means they silently drift out of sync with
# composer.lock (Livewire then warns "published assets are out of date").
/public/vendor
/storage/*.key
/storage/pail
/vendor
.env
.env.*
!.env.example
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
# Claude Code config (keep local, not in repo)
.claude/

# Production artifacts
storage/logs/*.log
storage/app/backups/
storage/app/temp/
storage/app/backup-audit/

# Built plugin packages — generated, never commit
dist/*.zip
dist/*.zip.sha256

# Debug scripts
dispatch_*.php

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Stray screenshots / pasted images at project root
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.bmp
migration-data/

# Coolify deploy token (local secret, never commit)
.coolify-deploy-token

# Prod DB dumps (local, never commit)
db-backups/

# Backup-v2 lab/spike: harness-ul e trackat explicit, dar tot ce generează rularea
# lui (fixture-uri, dump-uri, output de oracol) rămâne local.
spike/
lab/
.baseline-artifacts/

# lab dev secrets (throwaway)
lab/.lab-app-key
