# Version control
.git
.github
.gitignore
.gitattributes

# Editor / IDE
.claude
.editorconfig
.idea
.vscode
*.code-workspace

# Environment — never bake secrets into the image
.env
.env.*
!.env.example

# Node / JS — assets are built in the Docker multi-stage node build
node_modules
public/build

# Published package assets — the build republishes them from vendor/ so the image
# never inherits a stale copy from the build context (Coolify builds a fresh clone,
# where this directory does not exist at all).
public/vendor

# PHP dependencies — installed fresh by Composer inside the build
vendor

# Laravel runtime / generated files — these come from mounted volumes
bootstrap/cache/routes-v7.php
bootstrap/cache/config.php
bootstrap/cache/events.php
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/private/reports
storage/framework/testing

# Test code — not needed in production image
tests
database/factories
phpunit.xml

# Documentation (`*.md` prinde doar rădăcina — subdirectoarele se exclud explicit)
*.md
docs/
features/

# Claude Code / local tooling — not application code
.agents
.impeccable.md
skills-lock.json
bin
.phpunit.cache

# Docker / deploy tooling — not needed inside the container
docker-compose*.yml

# Labs, spikes and one-off build output — never part of the runtime image
spike/
lab/
dist/
workers/
.baseline-artifacts/

# OS / misc
.DS_Store
Thumbs.db
